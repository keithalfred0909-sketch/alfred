# Re-include paths that the parent repo's .gitignore excludes by name
!src/xquant/data/
!src/xquant/data/**
# ...but never Python bytecode caches inside it
src/xquant/data/**/__pycache__/
*.pyc
# Download cache (re-creatable; snapshots used for research live in datasets/)
cache/
# Scratch research runs; the canonical research output is committed under research_output/
runs/
!research_output/*.db
# SQLite write-ahead files (the .db is checkpointed before commit)
*.db-wal
*.db-shm
